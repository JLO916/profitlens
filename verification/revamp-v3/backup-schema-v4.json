{
  "$comment": "V3-0 產出（PRD §6.3 #59／#60、§11.8）：EC ProfitLens v2 工作區備份 v4 的欄位清單，從 src/application/workspace-backup.ts 的 envelopeSchema（zod strictObject）與 exportWorkspaceBackup 整理；key_paths 由 tests/backup-schema-v4.test.ts 以「所有選填欄位都有值」的匯出實測比對（陣列寫成 []，以雜湊或行號為鍵的紀錄寫成 {*}；opaque_records 列出的開放紀錄不再往下展開）。v3 新增欄位時升 v5，舊檔缺少的欄位補預設值（§11.8）。",
  "source": [
    "src/application/workspace-backup.ts（WORKSPACE_VERSION、envelopeSchema、exportWorkspaceBackup、restoreWorkspaceBackup）",
    "src/application/meeting.ts（meetingSchema）",
    "src/application/local-store.ts（IndexedDB 保存）"
  ],
  "schema_version": "profitlens-workspace-v4",
  "restore_accepts": [
    "profitlens-workspace-v4",
    "profitlens-workspace-v3",
    "profitlens-workspace-v2",
    "profitlens-workspace-v1"
  ],
  "restore_migration": "v1–v3 還原時 preprocessing／targets／events 為 null、ui_prefs 為 {}、meeting_history 為 []（EMPTY_V4_FIELDS）；v1–v3 信封若帶 v4 才有的欄位一律 INVALID_WORKSPACE_FORMAT。",
  "metric_version": "contribution-v1",
  "scenario_version": "scenario-v1",
  "integrity": "checksum = SHA-256(decisionSignature(信封去掉 checksum))；還原時先檢查 checksum，再以 strict schema 驗證（多一個欄位就拒絕），再重建快照比對雜湊。",
  "limits": {
    "max_bytes": 67108864,
    "max_structure_nodes": 1000000,
    "max_depth": 32,
    "max_raw_value_lines_per_file": 50000,
    "max_target_rows": 1000,
    "max_event_rows": 500,
    "max_meeting_history": 100,
    "max_plans_per_context": 3,
    "max_pinned_actions": 3
  },
  "top_level_keys": [
    "checksum",
    "metric_version",
    "payload",
    "saved_at",
    "scenario_version",
    "schema_version"
  ],
  "payload_keys": [
    "action_workspace",
    "active",
    "decision",
    "events",
    "meeting_history",
    "preprocessing",
    "review_session",
    "scenario_workspace",
    "sources",
    "targets",
    "ui_prefs"
  ],
  "payload": {
    "sources": {
      "type": "record<dataset_hash, DatasetInput>",
      "note": "所有被引用的原始 CSV（manifest＋三個檔案的文字），以內容雜湊為鍵；active、decision、各 context、review_session 以 source_hash 引用。原始 CSV 只在使用者自己的備份檔／本機，不上傳。"
    },
    "active": {
      "type": "object",
      "keys": [
        "source_hash",
        "filters",
        "id",
        "revision",
        "filenames",
        "mappings"
      ],
      "note": "目前工作區：資料來源、篩選（通路、兩期、比較方式）、原始檔名與欄位對照。"
    },
    "decision": {
      "type": "object | null",
      "note": "相容舊版的決策工作稿（目前通路 context 的方案與 R2 前的行動卡）。scenarios[] 帶選填 sensitivity。"
    },
    "action_workspace": {
      "type": "object",
      "keys": [
        "active_dataset_hash",
        "contexts",
        "items"
      ],
      "note": "待辦：items[] 的 card、scope、execution_status、progress_notes、binding_history；R5 選填 status_updated_at（YYYY-MM-DD）。"
    },
    "scenario_workspace": {
      "type": "object",
      "keys": [
        "schema_version",
        "active_epoch",
        "contexts",
        "assumptions_acknowledged_at"
      ],
      "note": "schema_version = scenario-workspace-v1；contexts[].plans[] 最多 3 個、帶 revision 與選填 sensitivity；versions[] 不存敏感度。V3-6 選填 assumptions_acknowledged_at（D-V3-12，見 scenario_assumptions_acknowledged）。"
    },
    "review_session": {
      "type": "object | null",
      "note": "會議稿 review-session-v1：固定範圍、門檻 importance_threshold、選入方案、置頂待辦、決議、備註、選填 meeting_date／created_at。"
    },
    "preprocessing": {
      "type": "object | null",
      "v4_addition": true,
      "keys": [
        "conversion",
        "raw_values"
      ],
      "note": "含稅換算摘要（basis=inclusive、rate、fields、rows_converted、totals）＋被換算格子的含稅原值（檔案 → 行號 → 欄位 → 原值）；還原時逐格重算比對。"
    },
    "targets": {
      "type": "object | null",
      "v4_addition": true,
      "keys": [
        "filename",
        "rows"
      ],
      "note": "targets.csv：rows[] 的 period_start、period_end、channel（或 ALL）、metric（net_revenue／gross_profit／contribution_after_marketing／ad_spend）、target、line。"
    },
    "events": {
      "type": "object | null",
      "v4_addition": true,
      "keys": [
        "filename",
        "rows"
      ],
      "note": "促銷檔期：rows[] 的 start、end、label（≤ 60 字）、line。"
    },
    "meeting_history": {
      "type": "array<meeting-v1>",
      "v4_addition": true,
      "max_items": 100,
      "note": "已結束的會議（R6，只讀快照）；每筆是 strict 的 meeting-v1（src/application/meeting.ts meetingSchema），還原時逐筆 validateMeeting 並深層凍結。V3-7 選填 copy_version（見 meeting_copy_version）。"
    },
    "ui_prefs": {
      "type": "object",
      "v4_addition": true,
      "note": "見下方 ui_prefs。"
    }
  },
  "ui_prefs": {
    "fields": {
      "view": {
        "type": "enum",
        "values": [
          "board",
          "list"
        ],
        "optional": true,
        "meaning": "待辦頁的看板／清單檢視（dashboard.tsx actionsView）"
      },
      "last_preset": {
        "type": "string",
        "min_length": 1,
        "max_length": 64,
        "optional": true,
        "meaning": "上次使用的期間快捷 id（dashboard.tsx lastPreset）"
      }
    },
    "storage": "只經由備份檔與 IndexedDB 的工作區副本保存；v2 的 src 沒有使用 localStorage／sessionStorage（見 storage-keys-v3.txt）。",
    "restore": "原樣讀回；v1–v3 備份讀回 {}。期間合計與日均的展開狀態只是 React state（dashboard.tsx periodOpen），不寫入備份、重新載入不保存。"
  },
  "scenario_sensitivity": {
    "paths": [
      "payload.scenario_workspace.contexts[].plans[].sensitivity",
      "payload.decision.scenarios[].sensitivity"
    ],
    "shape": {
      "volumes": [
        "string",
        "string",
        "string"
      ]
    },
    "optional": true,
    "note": "「要賣到多少才划算」每個方案三組輸入的原字串（R5，只在 v4 信封）；scenario_workspace.contexts[].versions[] 不存；v1–v3 信封帶此欄位即拒絕。"
  },
  "action_status_updated_at": {
    "path": "payload.action_workspace.items[].status_updated_at",
    "type": "YYYY-MM-DD",
    "optional": true,
    "note": "R5：狀態改變的日期；舊 v4 沒有時讀回 undefined。"
  },
  "scenario_assumptions_acknowledged": {
    "path": "payload.scenario_workspace.assumptions_acknowledged_at",
    "type": "ISO datetime",
    "optional": true,
    "v3_6_addition": true,
    "note": "D-V3-12＝B：同一工作區第一次勾「我了解這是試算，不是預測」的時間；有值時每個方案不再顯示勾選框，新增、複製與試算時聲明直接視為已勾。只在 v4 信封；沒有此欄位的舊 v4 讀回 undefined；v1–v3 信封帶此欄位即拒絕。"
  },
  "meeting_copy_version": {
    "path": "payload.meeting_history[].copy_version",
    "type": "literal \"v3\"",
    "optional": true,
    "v3_7_addition": true,
    "note": "D-V3-22＝A：v3 結束的會議（finalizeMeeting）寫 \"v3\"；v2 結束的紀錄與舊備份沒有此欄位（讀回 undefined），會議紀錄頁照紀錄顯示數字、決議與備註，欄名用新名詞，頂部加註「本紀錄建立於 v2，部分名稱已更新」。meetingSchema（strict）只接受 \"v3\" 或缺欄位；schema_version 仍是 meeting-v1。"
  },
  "opaque_records": {
    "manifest": "DatasetInput.manifest（z.record，內容即資料集 manifest）",
    "files": "三個 CSV 檔名 → 文字",
    "filenames": "標準檔名 → 使用者原始檔名",
    "mappings / source_mappings": "標準檔名 → 標準欄位 → 原始欄名",
    "raw_values": "檔案 → 原始行號 → 標準欄位 → 含稅原值",
    "totals": "換算欄位 → { raw, converted }",
    "confirmedUnknownColumns": "檔名 → 已確認忽略的欄名（選填，本範例沒有）"
  },
